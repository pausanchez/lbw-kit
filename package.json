{
  "name": "lbw-kit",
  "version": "0.13.0",
  "private": true,
  "description": "AI Widgets for the Landbot v4 web chat: the lbw.js runtime, the kit and their CSS, as one versioned library. Personal project, not an official Landbot product.",
  "scripts": {
    "version:sync": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "test": "node --test \"test/*.test.mjs\"",
    "build": "node scripts/build.mjs",
    "docs:public": "node scripts/public-docs.mjs",
    "docs:public:check": "node scripts/public-docs.mjs --check",
    "check": "npm run version:check && npm run build && npm run version:check && npm run schema:check && npm run reference:check && npm run docs:public:check && npm test",
    "check:config": "node scripts/check-config.mjs",
    "bot": "node scripts/bot-code.mjs",
    "mock": "node scripts/mock.mjs",
    "mock:report": "node scripts/mock-report.mjs",
    "schema": "node scripts/schema.mjs",
    "schema:check": "node scripts/schema.mjs --check",
    "types:check": "tsc --noEmit -p test/fixtures/types/tsconfig.json",
    "reference": "node scripts/type-docs.mjs",
    "reference:check": "node scripts/type-docs.mjs --check",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --project=chromium --grep @smoke",
    "capture:host": "node scripts/capture-host.mjs",
    "canary": "node scripts/canary.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2"
  },
  "repository": "pausanchez/lbw-kit",
  "types": "dist/lbw-kit.d.ts"
}
