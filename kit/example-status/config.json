{
  "prefix": "tn",
  "langs": ["es", "en"],
  "defaultLang": "es",
  "timeZone": "Europe/Madrid",
  "links": ["https://tallernorte.example/", "tel:", "mailto:"],

  "actions": {
    "call": { "tel": "600 000 000", "cc": "34", "label": { "es": "Llamar", "en": "Call" }, "icon": "phone" },
    "mail": { "mail": "hola@tallernorte.example", "label": { "es": "Escribir", "en": "Email us" }, "icon": "mail" },
    "book": { "reply": [{ "es": "Pedir cita", "en": "Book a slot" }, { "es": "Quiero pedir cita para el taller", "en": "I'd like to book a workshop slot" }, { "estado": "pedida" }], "icon": "calendar", "primary": true },
    "cancel": { "reply": [{ "es": "Anular la cita", "en": "Cancel the booking" }, { "es": "Quiero anular mi cita", "en": "I want to cancel my booking" }, { "estado": "anulada" }], "danger": true }
  },

  "widgets": {
    "repair": {
      "type": "cards", "kicker": { "es": "Tu reparación", "en": "Your repair" }, "links": ["book"],
      "status": { "param": "estado", "items": {
        "recibida": { "text": { "es": "Bici recibida en el taller", "en": "Bike received at the workshop" }, "tone": "info" },
        "pieza": { "text": { "es": "Esperando una pieza", "en": "Waiting for a part" }, "tone": "warn" },
        "lista": { "text": { "es": "Lista para recoger", "en": "Ready to collect" }, "tone": "ok",
          "links": [{ "reply": [{ "es": "Voy a recogerla", "en": "I'll collect it" }, { "es": "Voy a recoger la bici hoy", "en": "I'll collect the bike today" }, { "estado": "recogida" }], "icon": "check", "primary": true }] },
        "recogida": { "text": { "es": "Recogida: gracias", "en": "Collected: thank you" }, "tone": "ok", "links": [] },
        "retraso": { "text": { "es": "La pieza no llega esta semana", "en": "The part won't arrive this week" }, "tone": "warn",
          "links": [{ "reply": [{ "es": "Avisadme cuando llegue", "en": "Tell me when it arrives" }, { "es": "Avisadme cuando llegue la pieza", "en": "Tell me when the part arrives" }, { "aviso_pieza": "si" }], "icon": "bell", "primary": true }] } } },
      "items": {
        "revision": { "title": { "es": "Revisión completa", "en": "Full service" }, "badge": { "text": { "es": "La más pedida", "en": "Most booked" }, "tone": "info" },
          "rows": [[{ "es": "Plazo", "en": "Time" }, { "es": "2 días", "en": "2 days" }], [{ "es": "Desde", "en": "From" }, "45 €"]] },
        "pinchazo": { "title": { "es": "Pinchazo", "en": "Puncture" }, "badge": { "text": { "es": "En 20 min", "en": "In 20 min" }, "tone": "ok" },
          "status": { "text": { "es": "Se arregla en el momento", "en": "Fixed while you wait" }, "tone": "ok" },
          "rows": [[{ "es": "Plazo", "en": "Time" }, { "es": "20 min", "en": "20 min" }], [{ "es": "Desde", "en": "From" }, "12 €"]] }
      }
    },

    "booking": {
      "type": "cards", "kicker": { "es": "Tu cita", "en": "Your booking" }, "links": ["cancel"],
      "status": { "param": "estado", "items": { "anulada": { "text": { "es": "Cita anulada", "en": "Booking cancelled" }, "tone": "danger", "links": ["book"] }, "pedida": { "text": { "es": "Cita pedida: te confirmamos la hora", "en": "Booking requested: we'll confirm the time" }, "tone": "info" } } },
      "item": { "title": { "es": "Martes 17, 10:00", "en": "Tuesday 17, 10:00" }, "status": { "text": { "es": "Cita confirmada", "en": "Booking confirmed" }, "tone": "ok" }, "rows": [[{ "es": "Servicio", "en": "Service" }, { "es": "Revisión completa", "en": "Full service" }]] }
    },

    "contact": {
      "type": "contact", "kicker": { "es": "Contacto", "en": "Contact" }, "title": "Taller Norte", "big": "600 000 000",
      "hours": { "week": { "1": [[570, 840], [990, 1200]], "2": [[570, 840], [990, 1200]], "3": [[570, 840], [990, 1200]], "4": [[570, 840], [990, 1200]], "5": [[570, 840], [990, 1200]], "6": [[600, 840]] } },
      "buttons": ["call", "mail"]
    },

    "season": {
      "type": "season", "kicker": { "es": "Alquiler de bicis", "en": "Bike hire" }, "ranges": [["1/3/2026", "31/10/2026"], ["1/3/2027", "31/10/2027"]]
    },

    "quote": {
      "type": "review", "kicker": { "es": "Presupuesto", "en": "Quote" }, "title": { "es": "Revísalo", "en": "Check it" }, "cta": { "es": "Confirmar", "en": "Confirm" },
      "discard": [{ "es": "Descartar", "en": "Discard" }, { "es": "Descarto el presupuesto", "en": "I discard the quote" }], "note": { "es": "Precios ficticios.", "en": "Fake prices." },
      "state": { "tyres": { "values": ["no", "yes"], "default": "no" } },
      "tables": { "extra": { "no": 0, "yes": 3000 } },
      "compute": { "total": "4500 + extra[tyres]" },
      "money": { "cur": "€", "after": true, "cents": false },
      "lines": [{ "label": { "es": "Revisión", "en": "Service" }, "value": "45 €" }, { "label": { "es": "Ruedas nuevas", "en": "New tyres" }, "select": "tyres", "items": [["no", { "es": "No", "en": "No" }], ["yes", { "es": "Sí, +30 €", "en": "Yes, +€30" }]] }],
      "total": { "label": "Total", "value": "{total:money}" },
      "send": { "text": { "es": "Confirmo el presupuesto: {total:money}", "en": "I confirm the quote: {total:money}" }, "fields": { "tn_quote": "{total}" } }
    },

    "ok": {
      "type": "consent", "icon": "shield", "title": { "es": "¿Te avisamos por SMS?", "en": "Shall we text you?" }, "text": { "es": "Solo cuando esté lista. Demo: tu respuesta se guarda en un campo de prueba.", "en": "Only when it is ready. A demo: your answer is saved in a test field." },
      "yes": [{ "es": "Sí", "en": "Yes" }, { "es": "Sí, avisadme por SMS", "en": "Yes, text me" }, { "tn_sms": "yes" }], "no": [{ "es": "No", "en": "No" }, { "es": "No, gracias", "en": "No, thanks" }, { "tn_sms": "no" }]
    },

    "util": {
      "type": "rating", "kind": "thumbs", "title": { "es": "¿Te ha servido?", "en": "Was this useful?" }, "labels": [{ "es": "No", "en": "No" }, { "es": "Sí", "en": "Yes" }],
      "send": { "text": { "es": "Valoro la respuesta: {label}", "en": "I rate the answer: {label}" }, "fields": { "tn_util": "{value}" } }
    },

    "servicio": {
      "type": "rating", "kind": "stars", "kicker": { "es": "Tu reparación", "en": "Your repair" }, "title": { "es": "¿Qué tal el servicio?", "en": "How was the service?" },
      "send": { "text": { "es": "Le doy {value} de {max} estrellas", "en": "I give it {value} of {max} stars" }, "fields": { "tn_estrellas": "{value}" } }
    },

    "nps": {
      "type": "rating", "kind": "scale", "title": { "es": "¿Recomendarías el taller a un amigo?", "en": "Would you recommend us to a friend?" },
      "labels": [{ "es": "Nada probable", "en": "Not likely" }, { "es": "Muy probable", "en": "Very likely" }],
      "bands": [[6, "detractor"], [8, "pasivo"], [10, "promotor"]],
      "send": { "text": { "es": "Mi nota: {value} de 10", "en": "My score: {value} of 10" }, "fields": { "tn_nps": "{value}", "tn_nps_grupo": "{band}" } }
    },

    "bikes": {
      "type": "carousel", "kicker": { "es": "Bicis de alquiler", "en": "Hire bikes" }, "title": { "es": "Para este fin de semana", "en": "For this weekend" },
      "items": [
        { "id": "urbana", "name": { "es": "Urbana", "en": "City" }, "price": { "now": "15 €", "unit": { "es": "/día", "en": "/day" } }, "status": { "text": { "es": "6 libres", "en": "6 free" }, "tone": "ok" } },
        { "id": "electrica", "name": { "es": "Eléctrica", "en": "E-bike" }, "price": { "now": "35 €", "unit": { "es": "/día", "en": "/day" } }, "status": { "text": { "es": "Quedan 2", "en": "2 left" }, "tone": "warn" } },
        { "id": "montana", "name": { "es": "Montaña", "en": "Mountain" }, "price": { "now": "25 €", "unit": { "es": "/día", "en": "/day" } }, "status": { "text": { "es": "Agotada", "en": "Sold out" }, "tone": "danger" } }
      ]
    }
  }
}
